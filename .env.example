SECRET_KEY=replace-with-a-long-random-secret
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# PostgreSQL connection string from your hosting provider
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Razorpay: use test keys first, then live keys after KYC/testing
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=replace-with-32-plus-random-characters

# SMTP email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-business-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
